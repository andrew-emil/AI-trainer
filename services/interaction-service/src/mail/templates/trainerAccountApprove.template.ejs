<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
    xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Trainer Account Approved</title>

    <style>
        @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap");
    </style>

    <style>
        :root {
            color-scheme: light dark;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 16px;
            line-height: 1.65;
            color: #f2d38a;
            background-color: #120f0a;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        table {
            border-collapse: collapse;
            border-spacing: 0;
        }

        a {
            color: #d9b44a;
            text-decoration: none;
        }

        .wrapper {
            width: 100%;
            background-color: #120f0a;
            padding: 24px 0;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #1a140d;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid rgba(217, 180, 74, 0.22);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.55);
        }

        .header {
            padding: 36px 30px;
            text-align: center;
            background-color: #161009;
            border-bottom: 1px solid rgba(217, 180, 74, 0.18);
        }

        .content {
            padding: 36px 30px;
            background: #1a140d;
        }

        .title {
            font-family: "Cinzel", Georgia, "Times New Roman", serif;
            color: #f6dc9e;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 0.6px;
            margin: 0 0 14px 0;
        }

        .content p {
            color: rgba(242, 211, 138, 0.88);
            margin: 0 0 14px 0;
        }

        .divider {
            height: 1px;
            background-color: rgba(217, 180, 74, 0.22);
            margin: 24px 0;
        }

        .badge {
            display: inline-block;
            font-family: "Cinzel", Georgia, "Times New Roman", serif;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-size: 12px;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid rgba(42, 166, 160, 0.55);
            color: #2aa6a0;
            background-color: rgba(42, 166, 160, 0.10);
        }

        .btn-wrap {
            text-align: center;
            padding: 10px 0 4px 0;
        }

        .button {
            display: inline-block;
            padding: 14px 34px;
            color: #120f0a !important;
            background-color: #d9b44a;
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 0.9px;
            text-transform: uppercase;
            font-family: "Cinzel", Georgia, "Times New Roman", serif;
            border: 1px solid rgba(255, 235, 170, 0.35);
        }

        /* Info box */
        .info-box {
            background-color: #241b12;
            border-left: 4px solid #2aa6a0;
            padding: 14px;
            margin: 18px 0 0 0;
            border-radius: 6px;
        }

        .info-box p {
            margin: 0;
            font-size: 14px;
            line-height: 1.55;
            color: rgba(242, 211, 138, 0.92);
        }

        .info-box strong {
            color: #2aa6a0;
        }

        .footer {
            background-color: #141007;
            padding: 26px 24px;
            text-align: center;
            border-top: 1px solid rgba(217, 180, 74, 0.18);
        }

        .footer p {
            color: rgba(242, 211, 138, 0.75);
            font-size: 13px;
            margin: 0 0 10px 0;
        }

        .social-links {
            margin: 14px 0 8px 0;
            font-size: 13px;
            color: rgba(242, 211, 138, 0.65);
        }

        .social-links a {
            color: rgba(242, 211, 138, 0.8);
            margin: 0 6px;
        }

        .fine-print {
            margin-top: 14px;
            font-size: 12px;
            color: rgba(242, 211, 138, 0.62);
            line-height: 1.5;
        }

        @media only screen and (max-width: 600px) {
            .wrapper {
                padding: 10px 0 !important;
            }

            .container {
                width: 100% !important;
                border-radius: 0 !important;
            }

            .header {
                padding: 28px 20px !important;
            }

            .content {
                padding: 28px 20px !important;
            }

            .button {
                display: block !important;
                width: 100% !important;
                text-align: center !important;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center" style="padding: 0 12px">
                    <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0"
                        style="width: 100%; max-width: 600px">
                        <!-- Header -->
                        <tr>
                            <td class="header">
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"
                                    style="margin:0 auto;">
                                    <tr>
                                        <td style="vertical-align:middle; padding-right:12px;">
                                            <svg width="48" height="48" viewBox="0 0 60 60"
                                                xmlns="http://www.w3.org/2000/svg" role="img" aria-label="FR3ON FIT"
                                                style="display:block;">
                                                <defs>
                                                    <linearGradient id="goldGradientEmailApproval" x1="0%" y1="0%"
                                                        x2="100%" y2="100%">
                                                        <stop offset="0%" stop-color="#f3c758" />
                                                        <stop offset="50%" stop-color="#cf8217" />
                                                        <stop offset="100%" stop-color="#f0b828" />
                                                    </linearGradient>
                                                </defs>
                                                <path d="M30 5L55 50H5L30 5Z" fill="url(#goldGradientEmailApproval)"
                                                    stroke="#f5cf70" stroke-width="1" />
                                                <path d="M30 18L42 42H18L30 18Z" fill="#171511" stroke="#f0b828"
                                                    stroke-width="0.5" />
                                                <circle cx="30" cy="32" r="4" fill="url(#goldGradientEmailApproval)" />
                                            </svg>
                                        </td>
                                        <td style="vertical-align:middle; text-align:left;">
                                            <div
                                                style="font-family:'Cinzel', Georgia, 'Times New Roman', serif; font-weight:800; letter-spacing:4px; text-transform:uppercase; font-size:20px; line-height:1.1; color:#f3c758;">
                                                FR3ON
                                            </div>
                                            <div
                                                style="font-family:'Cinzel', Georgia, 'Times New Roman', serif; font-weight:700; letter-spacing:6px; text-transform:uppercase; font-size:12px; line-height:1.1; color:#f0b828; margin-top:2px;">
                                                FIT
                                            </div>
                                        </td>
                                    </tr>
                                </table>

                                <div style="margin-top:12px;">
                                    <span class="badge">Trainer Approved</span>
                                </div>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td class="content">
                                <h2 class="title">Your Trainer Account Has Been Approved</h2>

                                <p>Hi <%= username %>,</p>

                                <p>
                                    Your trainer account request has been reviewed and approved. You can now access
                                    trainer features and start building your coaching presence on fr3on fit.
                                </p>

                                <div class="divider"></div>

                                <p style="margin-bottom: 12px;">Continue by login to your account:</p>

                                <div class="btn-wrap">
                                    <a href=<%= loginLink %> class="button"
                                        style="background: linear-gradient(135deg, #d9b44a 0%, #b8862a 50%, #d9b44a 100%);">
                                        Login
                                    </a>
                                    <!--<![endif]-->
                                </div>

                                <div class="info-box">
                                    <p>
                                        <strong>Next steps:</strong> Complete your profile, add your specialties, and
                                        publish your first program so clients can discover you.
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td class="footer">
                                <p>© <%= new Date().getFullYear() %> fr3on fit. All rights reserved.</p>
                                <div class="social-links">
                                    <a href="https://www.facebook.com/Fr3onGym">Facebook</a> • <a href="https://www.instagram.com/fr3on_gym/">Instagram</a>
                                </div>
                                <p class="fine-print">
                                    If you have any questions, please contact us at
                                    <a href="mailto:support@fr3onfit.com"
                                        style="color: #2aa6a0">support@fr3onfit.com</a>
                                </p>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>