generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    trainer
    trainee
    admin
}

enum TraineeGoal {
    cut
    bulk
    maintenance
    strength
    body_recomb
}

enum Gender {
    male
    female
    unknown
}

enum TrainerApplicationStatus {
    pending
    approved
    rejected
}

enum membershipStatus {
    active
    inactive
}

enum RequestStatus {
    pending
    approved
    rejected
    cancelled_by_the_trainee
}

model User {
    id             String   @id @default(uuid())
    firstName      String
    lastName       String
    username       String   @unique
    email          String   @unique
    passwordHash   String
    role           UserRole
    gender         Gender   @default(unknown)
    avatar         String?
    avatarPublicId String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // One-to-One (shared PK)
    trainee Trainee?
    trainer Trainer?

    trainerApplications TrainerApplication[]
    refreshSessions     RefreshSession[]
    resetPasswordTokens ResetPasswordToken[]

    @@index([email])
    @@index([username])
}

model RefreshSession {
    id          String   @id @default(uuid())
    userId      String
    refreshHash String // store hashed refresh token
    expiresAt   DateTime
    createdAt   DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@index([refreshHash])
}

model Trainee {
    userId    String      @id
    goal      TraineeGoal
    heightCm  Int?
    createdAt DateTime    @default(now())
    isActive  Boolean     @default(true)

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trainer {
    userId          String   @id
    bio             String
    experienceYears DateTime @default(now())
    ratingAvg       Float    @default(0)
    ratingCount     Int      @default(0)
    rankScore       Float    @default(0)
    isActive        Boolean  @default(false)
    createdAt       DateTime @default(now())

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    certifications  TrainerCertification[]
    transformations TrainerTransformation[]
}

model TrainerCertification {
    id               String    @id @default(uuid())
    trainerId        String?
    trainerRequestId String?
    name             String
    imageUrl         String
    imagePublicId    String
    issuedBy         String?
    issuedAt         DateTime?
    updatedAt        DateTime  @updatedAt
    createdAt        DateTime  @default(now())

    trainer        Trainer?            @relation(fields: [trainerId], references: [userId], onDelete: Cascade)
    trainerRequest TrainerApplication? @relation(fields: [trainerRequestId], references: [id])

    @@unique([trainerId, name, imageUrl])
    @@index([trainerId])
    @@index([trainerRequestId])
}

model TrainerTransformation {
    id               String   @id @default(uuid())
    trainerId        String?
    trainerRequestId String?
    name             String
    imageUrl         String
    imagePublicId    String?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    trainer        Trainer?            @relation(fields: [trainerId], references: [userId], onDelete: Cascade)
    trainerRequest TrainerApplication? @relation(fields: [trainerRequestId], references: [id])

    @@unique([trainerId, name, imageUrl])
    @@index([trainerId])
    @@index([trainerRequestId])
}

model ResetPasswordToken {
    id        String    @id @default(uuid())
    userId    String
    tokenHash String
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@index([tokenHash])
}

model TrainerApplication {
    id     String @id @default(uuid())
    userId String @unique

    status    TrainerApplicationStatus @default(pending)
    adminNote String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    certifications  TrainerCertification[]
    transformations TrainerTransformation[]

    @@index([status])
}
