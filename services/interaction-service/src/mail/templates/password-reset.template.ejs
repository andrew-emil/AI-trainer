<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>Reset Your Password</title>

  <!-- Fonts (supported in Apple Mail, Gmail, most webmail; Outlook may fallback) -->
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap");
  </style>

  <style>
    :root {
      color-scheme: light dark;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      color: #f2d38a;
      /* foreground ~ gold */
      background-color: #120f0a;
      /* background ~ 40 15% 6% */
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    table {
      border-collapse: collapse;
      border-spacing: 0;
    }

    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    a {
      color: #d9b44a;
      /* primary */
      text-decoration: none;
    }

    /* Layout */
    .wrapper {
      width: 100%;
      background-color: #120f0a;
      padding: 24px 0;
    }

    .container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      background-color: #1a140d;
      /* card */
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(217, 180, 74, 0.22);
      /* border */
      box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.55);
      /* shadow-dark */
    }

    /* Header */
    .header {
      padding: 40px 30px 34px 30px;
      text-align: center;
      background-color: #161009;
      /* fallback */
      border-bottom: 1px solid rgba(217, 180, 74, 0.18);
    }

    /* Gradient header with Outlook VML fallback via conditional comments below */
    .header-inner {
      padding: 0;
    }

    .brand {
      font-family: "Cinzel", Georgia, "Times New Roman", serif;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: 30px;
      line-height: 1.2;
      color: #f6dc9e;
      margin: 0;
    }

    .tagline {
      margin: 10px 0 0 0;
      font-size: 14px;
      color: rgba(242, 211, 138, 0.85);
      letter-spacing: 0.4px;
    }

    /* Content */
    .content {
      padding: 38px 30px;
      background: #1a140d;
    }

    .content h2 {
      font-family: "Cinzel", Georgia, "Times New Roman", serif;
      color: #f6dc9e;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.6px;
      margin: 0 0 18px 0;
    }

    .content p {
      color: rgba(242, 211, 138, 0.88);
      font-size: 16px;
      line-height: 1.65;
      margin: 0 0 14px 0;
    }

    /* Egyptian divider */
    .divider {
      height: 1px;
      background-color: rgba(217, 180, 74, 0.22);
      margin: 26px 0;
    }

    /* Button */
    .btn-wrap {
      text-align: center;
      padding: 10px 0 6px 0;
    }

    .button {
      display: inline-block;
      padding: 14px 34px;
      color: #120f0a !important;
      background-color: #d9b44a;
      /* fallback */
      border-radius: 8px;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      font-family: "Cinzel", Georgia, "Times New Roman", serif;
      border: 1px solid rgba(255, 235, 170, 0.35);
    }

    /* Gmail supports :hover; Outlook desktop may ignore */
    .button:hover {
      box-shadow: 0 0 30px -5px rgba(217, 180, 74, 0.55);
      transform: translateY(-2px);
    }

    /* Code / token box (kept in case you later add OTP) */
    .code-box {
      background-color: #20180f;
      border: 1px dashed rgba(217, 180, 74, 0.6);
      border-radius: 10px;
      padding: 18px;
      text-align: center;
      margin: 18px 0 6px 0;
    }

    .code-box .code {
      font-size: 30px;
      font-weight: 800;
      color: #d9b44a;
      letter-spacing: 4px;
      font-family: "Courier New", monospace;
    }

    /* Warning / notice */
    .warning-box {
      background-color: #241b12;
      /* muted-ish */
      border-left: 4px solid #2aa6a0;
      /* accent turquoise */
      padding: 14px 14px 14px 14px;
      margin: 18px 0 0 0;
      border-radius: 6px;
    }

    .warning-box p {
      color: rgba(242, 211, 138, 0.92);
      margin: 0;
      font-size: 14px;
      line-height: 1.55;
    }

    .warning-box strong {
      color: #2aa6a0;
      /* accent */
    }

    /* Footer */
    .footer {
      background-color: #141007;
      /* sidebar-ish */
      padding: 26px 24px;
      text-align: center;
      border-top: 1px solid rgba(217, 180, 74, 0.18);
    }

    .footer p {
      color: rgba(242, 211, 138, 0.75);
      font-size: 13px;
      margin: 0 0 10px 0;
    }

    .social-links {
      margin: 14px 0 8px 0;
      font-size: 13px;
      color: rgba(242, 211, 138, 0.65);
    }

    .social-links a {
      color: rgba(242, 211, 138, 0.8);
      margin: 0 6px;
      text-decoration: none;
    }

    .fine-print {
      margin-top: 14px;
      font-size: 12px;
      color: rgba(242, 211, 138, 0.62);
      line-height: 1.5;
    }

    /* Responsive */
    @media only screen and (max-width: 600px) {
      .wrapper {
        padding: 10px 0 !important;
      }

      .container {
        width: 100% !important;
        border-radius: 0 !important;
      }

      .header {
        padding: 30px 20px !important;
      }

      .brand {
        font-size: 26px !important;
      }

      .content {
        padding: 28px 20px !important;
      }

      .content h2 {
        font-size: 20px !important;
      }

      .content p {
        font-size: 15px !important;
      }

      .button {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
      }

      .footer {
        padding: 20px !important;
      }
    }

    /* Dark mode (keep consistent; some clients override) */
    @media (prefers-color-scheme: dark) {

      body,
      .wrapper {
        background-color: #120f0a !important;
      }

      .container {
        background-color: #1a140d !important;
      }

      .content {
        background-color: #1a140d !important;
      }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 0 12px">
          <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0"
            style="width: 100%; max-width: 600px">
            <!-- Header -->
            <tr>
              <td class="header">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"
                  style="margin:0 auto;">
                  <tr>
                    <!-- Icon -->
                    <td style="vertical-align:middle; padding-right:12px;">
                      <!-- Inline SVG works in many clients (Apple Mail, Gmail web). Some Outlook versions may not render SVG. -->
                      <svg width="48" height="48" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"
                        aria-label="FR3ON FIT" role="img" style="display:block;">
                        <defs>
                          <linearGradient id="goldGradientEmail" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#f3c758" />
                            <stop offset="50%" stop-color="#cf8217" />
                            <stop offset="100%" stop-color="#f0b828" />
                          </linearGradient>
                        </defs>

                        <!-- Outer pyramid -->
                        <path d="M30 5L55 50H5L30 5Z" fill="url(#goldGradientEmail)" stroke="#f5cf70"
                          stroke-width="1" />
                        <!-- Inner pyramid -->
                        <path d="M30 18L42 42H18L30 18Z" fill="#171511" stroke="#f0b828" stroke-width="0.5" />
                        <!-- Eye center -->
                        <circle cx="30" cy="32" r="4" fill="url(#goldGradientEmail)" />
                      </svg>
                    </td>

                    <!-- Text -->
                    <td style="vertical-align:middle; text-align:left;">
                      <div style="
            font-family: 'Cinzel', Georgia, 'Times New Roman', serif;
            font-weight: 800;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-size: 20px;
            line-height: 1.1;
            color: #f3c758;
            margin: 0;
            padding: 0;
          ">
                        FR3ON
                      </div>
                      <div style="
            font-family: 'Cinzel', Georgia, 'Times New Roman', serif;
            font-weight: 700;
            letter-spacing: 6px;
            text-transform: uppercase;
            font-size: 12px;
            line-height: 1.1;
            color: #f0b828;
            margin: 2px 0 0 0;
            padding: 0;
          ">
                        FIT
                      </div>
                    </td>
                  </tr>

                  <!-- Optional tagline -->
                  <tr>
                    <td colspan="2" style="padding-top:10px; text-align:center;">
                      <div style="
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            font-size: 13px;
            color: rgba(242, 211, 138, 0.85);
            letter-spacing: 0.4px;
          ">
                        Your Fitness Journey Starts Here
                      </div>
                    </td>
                  </tr>
                </table>
              </td>

            </tr>

            <!-- Content -->
            <tr>
              <td class="content">
                <h2>Reset Your Password</h2>
                <p>Hi <%= userName %>,</p>
                <p>
                  We received a request to reset your password for your fr3on fit
                  account. If you didn't make this request, you can safely ignore
                  this email.
                </p>

                <div class="divider"></div>

                <p style="margin-bottom: 12px">To reset your password, click the button below:</p>

                <div class="btn-wrap">
                  <!-- Button with Outlook-friendly markup -->
                  <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="<%= resetLink %>" style="height:48px;v-text-anchor:middle;width:260px;" arcsize="16%" stroke="f" fillcolor="#d9b44a">
                        <w:anchorlock/>
                        <center style="color:#120f0a;font-family:Georgia, 'Times New Roman', serif;font-size:14px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">
                          Reset Password
                        </center>
                      </v:roundrect>
                    <![endif]-->
                  <!--[if !mso]><!-- -->
                  <a href="<%= resetLink %>" class="button"
                    style="background: linear-gradient(135deg, #d9b44a 0%, #b8862a 50%, #d9b44a 100%);">
                    Reset Password
                  </a>
                  <!--<![endif]-->
                </div>

                <div class="warning-box">
                  <p>
                    <strong>Security Notice:</strong> This reset link will expire
                    in <%= expirationTime %>. For your security, never share this link
                      with anyone.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="footer">
                <p>© <%= new Date().getFullYear() %> fr3on fit. All rights reserved.</p>

                <div class="social-links">
                  <a href="https://www.facebook.com/Fr3onGym">Facebook</a> • <a href="https://www.instagram.com/fr3on_gym/">Instagram</a>
                </div>

                <p class="fine-print">
                  If you have any questions, please contact us at
                  <a href="mailto:support@fr3onfit.com" style="color: #2aa6a0">support@fr3onfit.com</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>

</html>