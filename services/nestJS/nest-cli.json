{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "./tsconfig.json"
  },
  "projects": {
    "chatbot-service": {
      "type": "application",
      "root": "apps/chatbot-service",
      "entryFile": "main",
      "sourceRoot": "apps/chatbot-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chatbot-service/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "dashboard-service": {
      "type": "application",
      "root": "apps/dashboard-service",
      "entryFile": "main",
      "sourceRoot": "apps/dashboard-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dashboard-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "stream-service": {
      "type": "application",
      "root": "apps/stream-service",
      "entryFile": "main",
      "sourceRoot": "apps/stream-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stream-service/tsconfig.app.json"
      }
    },
    "test-gateway": {
      "type": "application",
      "root": "apps/test-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/test-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/test-gateway/tsconfig.app.json"
      }
    }
  }
}