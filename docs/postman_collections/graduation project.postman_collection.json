				{
					"name": "refresh_token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Successful POST request\", function () {",
									"  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"let jsonData = null;",
									"let raw = pm.response.text();",
									"",
									"try {",
									"  // If the whole response is JSON, this will work",
									"  jsonData = pm.response.json();",
									"} catch (e) {",
									"  // Try to locate a JSON object within a mixed response",
									"  const firstBrace = raw.indexOf('{');",
									"  if (firstBrace !== -1) {",
									"    const candidate = raw.slice(firstBrace);",
									"    try {",
									"      jsonData = JSON.parse(candidate);",
									"    } catch (inner) {",
									"      // Still not JSON; leave jsonData null",
									"    }",
									"  }",
									"}",
									"",
									"console.log(\"Raw response:\", raw);",
									"if (jsonData) {",
									"  console.log(\"Parsed JSON:\", jsonData);",
									"",
									"  // Adjust this path if your API changes",
									"  const token = _.get(jsonData, \"data.token\") || jsonData.token;",
									"  if (token) {",
									"    pm.environment.set(\"authToken\", token);",
									"    console.log(\"Token saved to environment:\", token);",
									"  } else {",
									"    console.warn(\"No token found in response JSON.\");",
									"  }",
									"} else {",
									"  console.warn(\"Response is not valid JSON. Skipping JSON-based assertions and token save.\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
