generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  PASSWORD_RESET
  TRAINER_APPROVAL
  TRAINER_REJECTION
  NEW_CHAT_MESSAGE
  TRAINER_RANK_CHANGED
  NEW_TRAINER_REGISTERED
  NEW_TRAINEE_REQUESTED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  data      Json?
  deep_link String?

  readAt DateTime?

  createdAt DateTime @default(now())
}

model preferences {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  isEnabled        Boolean          @default(true)
}

model GlobalNotification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  content   String
  data      Json?
  deep_link String?

  createdAt DateTime @default(now())

  userGlobalNotificationStatus UserGlobalNotificationStatus[]
}

model UserGlobalNotificationStatus {
  id                   String             @id @default(uuid())
  userId               String
  globalNotificationId String
  globalNotification   GlobalNotification @relation(fields: [globalNotificationId], references: [id], onDelete: Cascade)

  readAt DateTime?
}
